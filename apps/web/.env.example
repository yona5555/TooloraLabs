# Copy this file to .env.local and fill in real values.
# Only forex-converter and commodities-tracker need these — every other
# tool in the app runs with no environment configuration at all.

# https://www.exchangerate-api.com/ (free tier: 1,500 requests/month)
EXCHANGE_RATE_API_KEY=

# https://metalpriceapi.com/ (used by commodities-tracker for gold/silver)
METALPRICE_API_KEY=

# https://www.oilpriceapi.com/ (used by commodities-tracker for oil)
OILPRICE_API_KEY=
