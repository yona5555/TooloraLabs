# Copy this file to .env.local and fill in real values.
# Only forex-converter and commodities-tracker need these — every other
# tool in the app runs with no environment configuration at all.

# https://www.exchangerate-api.com/ (free tier: 1,500 requests/month)
EXCHANGE_RATE_API_KEY=

# https://metalpriceapi.com/ (used by commodities-tracker for gold/silver)
METALPRICE_API_KEY=

# https://www.oilpriceapi.com/ (used by commodities-tracker for oil)
OILPRICE_API_KEY=

# --- Analytics & search engine verification (all optional) ---
# See docs/SEO_SETUP.md for how to obtain each of these manually.
# Nothing below fires or renders until its value is set.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console ownership-verification meta tag content
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership-verification meta tag content
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Brave Search ownership-verification meta tag content
NEXT_PUBLIC_BRAVE_SITE_VERIFICATION=
