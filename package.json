{
  "name": "tooloralabs",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "phone": "node scripts/phone-preview.mjs",
    "phone:iphone": "node scripts/phone-preview.mjs --iphone",
    "postinstall": "patch-package",
    "check:json": "node scripts/check-json.mjs",
    "test:home-phone": "node tests/home-phone-regression.mjs",
    "test:phone-order": "node tests/phone-card-order.mjs",
    "baseline:home-phone": "node tests/home-phone-regression.mjs --write",
    "build:desktop-lock": "NEXT_TELEMETRY_DISABLED=1 NEXT_DIST_DIR=.next-lock NODE_OPTIONS=--import=$PWD/tests/fixtures/offline-fetch.mjs npm run build --workspace=apps/web",
    "test:desktop-lock": "node tests/desktop-lock.mjs",
    "test:desktop-lock:full": "node tests/desktop-lock.mjs --full",
    "baseline:desktop-lock": "node tests/desktop-lock.mjs --write",
    "test:main-health": "node --test scripts/main-health.test.mjs",
    "test:color-lock": "node --test tests/color-lock.test.mjs",
    "test:hydration-guard": "node --test tests/hydration-guard.test.mjs",
    "test:gate": "node --test scripts/run-no-warnings.test.mjs",
    "test:share-images": "node --test tests/share-images.test.mjs",
    "test:gates-self-test": "node --test --test-concurrency=1 tests/gates-self-test.mjs",
    "test:system-fonts": "node scripts/system-fonts.mjs",
    "site-audit": "scripts/site-audit.sh",
    "perf-budget": "scripts/perf-budget.sh",
    "ratchet:check:site-audit": "node scripts/ratchet.mjs check site-audit",
    "ratchet:check:perf-budget": "node scripts/ratchet.mjs check perf-budget",
    "ratchet:update": "node scripts/ratchet.mjs update"
  },
  "devDependencies": {
    "minimatch": "file:tooling/minimatch-compat",
    "patch-package": "^8.0.1",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "@swc/core": true,
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "fsevents": true,
    "core-js": false
  },
  "overrides": {
    "katex": "^0.19.1",
    "lighthouse": {
      "@sentry/node": "11.8.0"
    },
    "minimatch": "$minimatch",
    "glob": "^14.0.3"
  }
}
