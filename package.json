{
  "name": "tooloralabs",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "phone": "node scripts/phone-preview.mjs",
    "phone:iphone": "node scripts/phone-preview.mjs --iphone",
    "postinstall": "patch-package",
    "check:json": "node scripts/check-json.mjs",
    "test:home-phone": "node tests/home-phone-regression.mjs",
    "test:phone-order": "node tests/phone-card-order.mjs",
    "baseline:home-phone": "node tests/home-phone-regression.mjs --write"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "@swc/core": true,
    "unrs-resolver": true,
    "@parcel/watcher": true,
    "fsevents": true,
    "core-js": false
  }
}
